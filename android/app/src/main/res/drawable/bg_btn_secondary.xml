<?xml version="1.0" encoding="utf-8"?>
<!-- 次级按钮（打开 HTTP/HTTPS）：禁用=浅灰置灰，可用=白底描边 + 绿色 ripple -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_disabled_bg" />
            <stroke android:width="1dp" android:color="@color/btn_disabled_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="#1F0F9D58">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/card" />
                    <stroke android:width="1dp" android:color="@color/field_border" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
